# APICS Gateway Configuration Environment Variables for Vercel
# Semua variabel ini opsional, juga dapat diatur langsung lewat Dashboard Web di browser!

# 1. Raw QRIS String (Dapat diambil dari scan QRIS toko / merchant Anda)
CUSTOM_QRIS_RAW="00020101021126570011ID.DANA.WWW011893600915303341139902090334113990303UMI51440014ID.CO.QRIS.WWW0215ID10265535024060303UMI5204504553033605802ID5925Jamaludin Phone, Komputer6015Kota Jakarta Se610512810630478D6"

# 2. Opsional: URL Gambar QRIS Langsung (jika Anda ingin memakai gambar statis)
CUSTOM_QR_IMAGE_URL=""

# 3. Dynamic QRIS Mode (true = otomatis injeksi nominal deposit ke m-banking, false = gunakan raw QRIS statis)
QRIS_DYNAMIC_MODE="true"

# 4. Auto-Approve / Auto-Mutasi Transaksi (true = transaksi pending otomatis success)
AUTO_APPROVE="true"

# 5. Waktu tunggu sebelum status berubah jadi 'success' (dalam satuan detik, default: 15 detik)
AUTO_APPROVE_DELAY="15"

# 6. Informasi Rekening Bank Transfer
BANK_NAME="BCA"
BANK_ACCOUNT_NUMBER="8830192837"
BANK_ACCOUNT_NAME="PT GERBANG PEMBAYARAN"

# 7. Kredensial API Header (Opsional / Fleksibel)
GATEWAY_API_KEY="KEY_ANDA"
GATEWAY_SECRET_KEY="SECRET_ANDA"
